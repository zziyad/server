{
  "name": "nodejs-pure",
  "version": "13.0.0",
  "description": "Pure NodeJS application runtime",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node --max-old-space-size=512 --expose-gc main.js",
    "start:prod": "node --max-old-space-size=1024 --expose-gc main.js",
    "start:debug": "node --max-old-space-size=512 --expose-gc --inspect main.js",
    "test": "node --test test/*.test.js",
    "test:all": "node --test test/*.test.js && npm run lint && tsc",
    "lint": "eslint . && prettier -c \"**/*.js\" \"**/*.ts\"",
    "fmt": "prettier --write \"**/*.js\" \"**/*.ts\""
  },
  "engines": {
    "node": "16 || 18 || 19 || 20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "metasql": "^3.0.0-alpha.2",
    "metautil": "^3.7.2",
    "metawatch": "^1.2.2",
    "multiparty": "^4.2.3",
    "nodemailer": "^6.9.14",
    "pg": "^8.8.0",
    "redis": "^5.8.2",
    "web-push": "^3.6.7",
    "ws": "^8.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^18.11.18",
    "@types/pg": "^8.6.6",
    "@types/ws": "^8.5.4",
    "eslint": "^8.31.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-import": "^2.23.4",
    "eslint-plugin-prettier": "^4.2.1",
    "prettier": "^2.8.2",
    "typescript": "^5.0.4"
  }
}
