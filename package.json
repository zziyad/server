{
  "name": "index-search-server",
  "version": "0.1.0",
  "description": "Minimal server-based index/search layer prototype",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node --max-old-space-size=512 main.js",
    "lint": "find application scripts lib -name '*.js' -print0 | xargs -0 -n1 node --check && node --check main.js",
    "test": "npm run test:core",
    "db:migrate": "node scripts/migrate-db.js"
  },
  "engines": {
    "node": "20 || 22"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "metautil": "^3.7.2",
    "metawatch": "^1.2.2",
    "multiparty": "^4.2.3",
    "pg": "^8.20.0",
    "ws": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^18.11.18",
    "@types/ws": "^8.5.4",
    "eslint": "^8.31.0",
    "prettier": "^2.8.2",
    "typescript": "^5.0.4"
  }
}
